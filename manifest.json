{
    "manifest_version":  3,
    "name":  "WhatsApp Alerta Central",
    "version":  "1.2.15",
    "description":  "Toast profissional de 10 segundos para qualquer estado nÃ£o lido no WhatsApp Web, com leitura refinada por acessibilidade, badges e arquivadas.",
    "permissions":  [
                        "storage",
                        "tabs",
                        "notifications",
                        "scripting",
                        "alarms"
                    ],
    "host_permissions":  [
                             "https://web.whatsapp.com/*",
                             "http://*/*",
                             "https://*/*"
                         ],
    "background":  {
                       "service_worker":  "background.js",
                       "type":  "module"
                   },
    "action":  {
                   "default_title":  "WhatsApp Alerta Central",
                   "default_popup":  "popup.html"
               },
    "options_page":  "options.html",
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://web.whatsapp.com/*"
                                            ],
                                "js":  [
                                           "content-whatsapp.js"
                                       ],
                                "run_at":  "document_idle"
                            },
                            {
                                "matches":  [
                                                "http://*/*",
                                                "https://*/*"
                                            ],
                                "js":  [
                                           "content-ui.js"
                                       ],
                                "css":  [
                                            "content-ui.css"
                                        ],
                                "run_at":  "document_idle"
                            }
                        ],
    "icons":  {
                  "16":  "icons/icon16.png",
                  "32":  "icons/icon32.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              }
}
