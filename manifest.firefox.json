{
  "manifest_version": 3,
  "name": "WhatsApp Alerta Central",
  "version": "1.4.2",
  "description": "Alertas locais do WhatsApp Web com central de pendências, horário de silêncio, regras por conversa, badge, soneca rápida e diagnóstico.",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "WhatsApp Alerta Central",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content-whatsapp.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-ui.js"
      ],
      "css": [
        "content-ui.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Hagliberto Alves de Oliveira",
  "browser_specific_settings": {
    "gecko": {
      "id": "@whatsapp-alerta-central.hagliberto",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "homepage_url": "https://github.com/Hagliberto/whatsapp-alerta-central"
}
